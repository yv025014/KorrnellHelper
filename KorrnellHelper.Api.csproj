<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
      <UserSecretsId>4998189e-e0c1-4cad-9a2a-4bff7687af49</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="Pgvector" Version="0.3.2" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="KorrnellHelper.Application\KorrnellHelper.Application.csproj" />
      <ProjectReference Include="KorrnellHelper.Infrastructure\KorrnellHelper.Infrastructure.csproj" />
    </ItemGroup>

    <!--
      KorrnellHelper.Api.csproj sits at the solution root, with the other three
      projects nested underneath it as subfolders. Without these excludes, the
      SDK's default "**/*.cs" glob would compile their source files directly
      into the Api assembly too, on top of referencing them as separate DLLs
      via ProjectReference above — causing duplicate-type build errors.
    -->
    <ItemGroup>
      <Compile Remove="KorrnellHelper.Application\**\*.cs" />
      <Compile Remove="KorrnellHelper.Domain\**\*.cs" />
      <Compile Remove="KorrnellHelper.Infrastructure\**\*.cs" />
      <Compile Remove="KorrnellHelper.Tests\**\*.cs" />
    </ItemGroup>

</Project>
